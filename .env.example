# Copy to .env for local development. Replace all placeholders before deployment.
NODE_ENV=development
API_PORT=3000
API_BASE_PATH=/api/v1

# JWT: use a unique, randomly generated signing key in each real environment.
JWT_ISSUER=cab-system-local
JWT_AUDIENCE=cab-system-local-clients
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# PostgreSQL (local development only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=replace-me
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking_service
BOOKING_DB_PASSWORD=replace-me
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=replace-me

# MongoDB (local development only)
MONGODB_URI=mongodb://localhost:27017
DRIVER_DB_NAME=driver_db
DRIVER_SECURE_DB_NAME=driver_secure_db
NOTIFICATION_DB_NAME=notification_db
ADMIN_DB_NAME=admin_db
MONGODB_USERNAME=replace-me
MONGODB_PASSWORD=replace-me

# Kafka (local development only)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=cab-system-local
KAFKA_GROUP_ID_PREFIX=cab

# Payment provider mock configuration
PAYMENT_PROVIDER_BASE_URL=http://localhost:4010
PAYMENT_PROVIDER_WEBHOOK_SECRET=replace-with-a-random-secret
